        { "key": "fire", "label": "Fire Attendant (9 kg foam)", "notOutgoing": false, "notIncoming": false } ] },
      { "id": "jerry25", "label": "Jerry cans 25 L", "canL": 25, "maxStoredL": 75, "roles": [
        { "key": "refueller", "label": "Vehicle Refueller", "notOutgoing": true, "notIncoming": true },
